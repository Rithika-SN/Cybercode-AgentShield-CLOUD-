{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.local"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ],
      "cache": true
    },
    "lint": {
      "outputs": [
        ".eslintcache"
      ]
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false
    }
  }
}
